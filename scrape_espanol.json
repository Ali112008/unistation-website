"Country\",\n        \"name\": \"United Kingdom\"\n      },\n      {\n        \"@type\": \"Country\",\n        \"name\": \"United States\"\n      },\n      {\n        \"@type\": \"Country\",\n        \"name\": \"United Arab Emirates\"\n      }\n    ],\n    \"employee\": [\n      {\n        \"@type\": \"Person\",\n        \"name\": \"Bassel Fayad\",\n        \"jobTitle\": \"General Director\",\n        \"description\": \"With a vision to redefine the study abroad experience, Basel brings a modern approach to academic consulting. Known for his leadership and strategic mindset, he ensures every student journey with Uni Station is guided by clarity, innovation, and trust.\"\n      },\n      {\n        \"@type\": \"Person\",\n        \"name\": \"Ahmed Mansour\",\n        \"jobTitle\": \"Operations Manager & Team Lead\",\n        \"description\": \"Ahmed combines precision with empathy. As the backbone of the operations team, he ensures every application, consultation, and process runs smoothly.\"\n      },\n      {\n        \"@type\": \"Person\",\n        \"name\": \"Layla Karim\",\n        \"jobTitle\": \"Academic Advisor\",\n        \"description\": \"Layla specializes in guiding students through complex admission pathways. With over eight years in academic counseling, she's helped countless students gain entry to top universities worldwide.\"\n      },\n      {\n        \"@type\": \"Person\",\n        \"name\": \"Omar Haddad\",\n        \"jobTitle\": \"Language Program Coordinator\",\n        \"description\": \"Omar oversees Uni Station's language preparation programs, ensuring students master English, German, or Spanish before their journey abroad.\"\n      }\n    ],\n    \"offers\": [\n      {\n        \"@type\": \"EducationalOccupationalProgram\",\n        \"name\": \"Spanish Language Program\",\n        \"description\": \"Language preparation program for Spanish\",\n        \"provider\": {\n          \"@type\": \"EducationalOrganization\",\n          \"name\": \"UniStation\"\n        }\n      },\n      {\n        \"@type\": \"EducationalOccupationalProgram\",\n        \"name\": \"English Language Program\",\n        \"description\": \"Language preparation program for English\",\n        \"provider\": {\n          \"@type\": \"EducationalOrganization\",\n          \"name\": \"UniStation\"\n        }\n      },\n      {\n        \"@type\": \"EducationalOccupationalProgram\",\n        \"name\": \"German Language Program\",\n        \"description\": \"Language preparation program for German\",\n        \"provider\": {\n          \"@type\": \"EducationalOrganization\",\n          \"name\": \"UniStation\"\n        }\n      }\n    ]\n  }\n}\n</script><style>\n/* --- Font Smoothing --- */\nbody {\n  -moz-osx-font-smoothing: grayscale;\n  -webkit-font-smoothing: antialiased;\n}\n</style>\n\n<!-- Meta Pixel Code -->\n<script>\n!function(f,b,e,v,n,t,s)\n{if(f.fbq)return;n=f.fbq=function(){n.callMethod?\nn.callMethod.apply(n,arguments):n.queue.push(arguments)};\nif(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';\nn.queue=[];t=b.createElement(e);t.async=!0;\nt.src=v;s=b.getElementsByTagName(e)[0];\ns.parentNode.insertBefore(t,s)}(window, document,'script',\n'https://connect.facebook.net/en_US/fbevents.js');\nfbq('init', '839143215890590');\nfbq('track', 'PageView');\n</script>\n<noscript><img height=\"1\" width=\"1\" style=\"display:none\"\nsrc=\"https://www.facebook.com/tr?id=839143215890590&ev=PageView&noscript=1\"\n/></noscript>\n<!-- End Meta Pixel Code -->\n\n<meta name=\"facebook-domain-verification\" content=\"ytuf6jmo3uo2j9ncr5q4985rqk2ke3\"><script src=\"https://cdn.prod.website-files.com/68fd63e9503df62b019b5c75%2F6544eda5f000985a163a8687%2F6a032d2250df278a383344a9%2Ffinsweetcomponentsconfig-1.0.2.js\" type=\"module\" async=\"\" siteid=\"68fd63e9503df62b019b5c75\" finsweet=\"components\"></script><style fs-components-cloak=\"cloak\">\n     [fs-marquee-instance],[fs-cnumbercount-instance]{ opacity: 0; }\n    [fs-consent-el